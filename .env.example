# Database (Supabase PostgreSQL).
# The Next.js app uses the transaction-pooled connection (port 6543)
# with `?pgbouncer=true`. Prisma + PrismaPg handle session loss
# correctly.
DATABASE_URL=postgresql://postgres:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# graphile-worker connection. MUST be the DIRECT connection (port 5432),
# not the transaction-pooled one — the worker uses named prepared
# statements, which pgBouncer transaction-mode drops between calls.
# Symptom if you forget: every other worker job fails with
# `prepared statement <hash> does not exist`.
WORKER_DATABASE_URL=postgresql://postgres:password@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3003
AUTH_SECRET=your-auth-secret-here
AUTH_ALLOWED_EMAILS=devontjsmith@gmail.com,jaaker@stanford.edu

# Mobile shell
# Capacitor loads the live Next.js app from this URL. Use an HTTPS
# domain for TestFlight/App Store builds; use a LAN URL only for local
# device testing.
CAPACITOR_SERVER_URL=https://crm.your-domain.com

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# Anthropic (AI features)
ANTHROPIC_API_KEY=your-anthropic-key
# Optional override. Defaults to claude-sonnet-4-6.
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6

# User Profile (customize per deployment)
CRM_USER_FIRST_NAME=Jennifer
CRM_USER_FULL_NAME=Jennifer
CRM_USER_BIO=a professor, author, and researcher
CRM_USER_EMAIL_SIGNOFF=Jennifer
CRM_USER_STYLE=warm and caring, writes in complete sentences, uses proper punctuation, a bit more formal than texting shorthand

# Voyage AI embeddings for semantic contact search (Milestone 2.5 part 2).
# Get a key at https://www.voyageai.com/. Backfill cost is ~$0.02 for 30k contacts.
VOYAGE_API_KEY=

# OpenAI Whisper for voice-memo transcription (Milestone 3.1).
# Set to enable the "Record voice memo" button on contact pages.
# Cost: ~$0.006/min of audio. ~25¢ for an hour of memos.
OPENAI_API_KEY=

# Set to "true" once the Graphile Worker has been running reliably for
# a few days. Disables the browser-side useAutoSync hook so the
# server-side gmail-sync / calendar-sync tasks are the only path that
# touches Gmail / Calendar. Removes a redundant per-tab poll.
NEXT_PUBLIC_DISABLE_BROWSER_SYNC=

# Brave Search for nightly news-mention detection of high-tier
# contacts (Milestone 5.2). Get a key at
# https://api.search.brave.com/app/keys. Free tier 2k searches/month
# — well above the ~30/week the signal-detection worker uses.
BRAVE_API_KEY=

# Push sync (Milestones 1.2 + 1.3). See PUBSUB.md for setup.
# All three are required to enable push; without them the CRM falls
# back to the worker's polling schedule (every 3 min Gmail / 30 min
# Calendar) which is fine but ~10x slower to surface new emails.
GMAIL_PUBSUB_TOPIC=
WEBHOOK_BASE_URL=
WEBHOOK_TOKEN=
