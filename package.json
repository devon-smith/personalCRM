{
  "name": "personal-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--max-http-header-size=32768' next dev --port 3003",
    "dev:mobile": "NODE_OPTIONS='--max-http-header-size=32768' next dev --port 3003 --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "drafts:regenerate-stale": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config scripts/regenerate-stale-reply-drafts.ts",
    "worker": "tsx worker/index.ts",
    "worker:migrate": "graphile-worker --connection \"${WORKER_DATABASE_URL:-$DATABASE_URL}\" --schema-only",
    "mobile:add:ios": "npx cap add ios",
    "mobile:add:android": "npx cap add android",
    "mobile:sync": "npx cap sync",
    "mobile:sync:ios": "npx cap sync ios",
    "mobile:doctor:ios": "npx cap doctor ios",
    "mobile:open:ios": "npx cap open ios",
    "mobile:open:android": "npx cap open android",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@base-ui/react": "^1.2.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@prisma/adapter-pg": "^7.4.2",
    "@tanstack/react-query": "^5.90.21",
    "@types/diff": "^7.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "geist": "^1.7.0",
    "graphile-worker": "^0.16.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@prisma/client": "^7.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
