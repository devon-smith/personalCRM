generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth Models ────────────────────────────────────────

model User {
  id                    String    @id @default(uuid())
  name                  String?
  email                 String?   @unique
  emailVerified         DateTime?
  image                 String?
  onboardingCompletedAt DateTime?
  // M0.x.3: rail-nav dot indicator and "what's new since I last
  // looked" affordances on the /feed page reference this. POST
  // /api/feed/visit updates it on each visit.
  lastFeedVisitAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  contacts             Contact[]
  interactions         Interaction[]
  relationshipInsights RelationshipInsight[]
  weeklyDigests        WeeklyDigest[]
  circles              Circle[]
  actionItems          ActionItem[]
  sightings            ContactSighting[]
  gmailSync            GmailSyncState?
  whatsappSync         WhatsAppSyncState?
  imessageSyncStates   IMessageSyncState[]
  emailMessages        EmailMessage[]
  drafts               Draft[]
  extensionTokens      ExtensionToken[]
  inboxItems           InboxItem[]
  threads              Thread[]
  voiceProfile         VoiceProfile?
  voiceExamples        VoiceExample[]
  voiceReferences      VoiceReference[]
  savedQueries         SavedQuery[]
  observations         AssistantObservation[]
  classifierFeedback   ClassifierFeedback[]
  lifeEventSignals     LifeEventSignal[]
  feedItems            FeedItem[]
  apiUsageLog          ApiUsageLog[]
  importLog            ImportLog[]
  mergeLog             MergeLog[]
  dailyPriorityQueue   DailyPriorityQueue[]
  inboxPriorityItems   InboxPriorityItem[]
}

model Account {
  id                String    @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?   @db.Text
  access_token      String?   @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?   @db.Text
  session_state     String?
  needsReconnect    Boolean   @default(false)
  lastRefreshAt     DateTime?
  lastRefreshError  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model SyncLog {
  id        String   @id @default(uuid())
  userId    String
  accountId String?
  kind      String
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
}

model ContactsSyncCursor {
  id             String    @id @default(uuid())
  userId         String
  accountId      String
  nextSyncToken  String?
  lastSyncAt     DateTime?
  lastFullSyncAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, accountId])
  @@index([userId])
}

model ExternalResearchCache {
  id          String   @id @default(uuid())
  source      String // "openalex" | "crossref" | "semanticscholar" | "orcid"
  kind        String // "author_search" | "author" | "works" | "doi" | ...
  externalKey String // the search query, author id, DOI, etc.
  data        Json
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([source, kind, externalKey])
  @@index([expiresAt])
}

model AIGenerationLog {
  id        String   @id @default(uuid())
  userId    String
  feature   String // "draft" | "classify" | "insight" | ...
  model     String
  inputRefs Json? // string[] of source record IDs the prompt drew from
  outputId  String? // FK-ish reference to whatever record stored the result
  tokensIn  Int?
  tokensOut Int?
  cacheHit  Boolean?
  latencyMs Int?
  error     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([feature, createdAt(sort: Desc)])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core CRM Models ────────────────────────────────────────

enum ContactTier {
  INNER_CIRCLE
  PROFESSIONAL
  ACQUAINTANCE
}

enum ContactSource {
  MANUAL
  CSV_IMPORT
  GOOGLE_CONTACTS
  GMAIL_DISCOVER
  APPLE_CONTACTS
  IMESSAGE
  LINKEDIN
  WHATSAPP
}

enum SightingResolution {
  PENDING
  AUTO_MERGED
  REVIEW_NEEDED
  MANUALLY_MERGED
  MANUALLY_REJECTED
  NEW_CONTACT
}

model Contact {
  id               String        @id @default(uuid())
  userId           String
  name             String
  email            String?
  additionalEmails String[]      @default([])
  phone            String?
  additionalPhones String[]      @default([])
  company          String?
  role             String?
  tier             ContactTier   @default(PROFESSIONAL)
  tags             String[]
  nicknames        String[]      @default([])
  aliases          String[]      @default([])
  linkedinUrl      String?
  city             String?
  state            String?
  country          String?
  latitude         Float?
  longitude        Float?
  notes            String?       @db.Text
  followUpDays     Int?
  lastInteraction  DateTime?
  avatarUrl        String?
  birthday         DateTime?     @db.Date
  howWeMet         String?       @db.Text
  source           ContactSource @default(MANUAL)
  importedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // pgvector embedding for semantic search. 512 dims matches the Voyage AI
  // voyage-3-lite model. Managed via raw SQL — Prisma doesn't natively
  // support the vector type, so `Unsupported` keeps the column visible
  // in the schema without breaking the query API.
  embedding          Unsupported("vector(512)")?
  embeddingUpdatedAt DateTime?

  // Scholarly profile linkage (Milestone 2.3 — Meeting prep dossier).
  // Populated when the prep flow matches a contact to OpenAlex / ORCID.
  openAlexAuthorId             String?
  orcid                        String?
  scholarlyProfileMatchedAt    DateTime?
  // Last observed OpenAlex institution; used by the nightly diff job
  // (Milestone 3.5) to detect affiliation changes.
  lastSeenScholarlyInstitution String?

  // People API resourceName for Google contact-group sync (3.2).
  // Populated lazily on the first contacts sync after the 3.2
  // migration; group-membership modifications need this ID rather
  // than emails.
  peopleApiResourceName String?

  // Soft-quarantine flag (M0.4). True when this contact looks like a
  // system artifact ("Settings", "noreply@…", LinkedIn bots, etc).
  // Default-filtered out of search, neighbors, and /people; a UI
  // toggle can still reveal them so false positives are recoverable.
  isNoise Boolean @default(false)

  // Soft-delete marker. Set when a contact is merged into another via
  // MergeLog; the row is retained for merge-undo + audit history.
  // No application code references this today (the live merge path
  // does a hard delete after writing MergeLog), but the column
  // exists in prod for historical merge data.
  deletedAt DateTime?

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions        Interaction[]
  relationshipInsight RelationshipInsight?
  circles             ContactCircle[]
  actionItems         ActionItem[]
  sightings           ContactSighting[]
  journalEntries      JournalEntry[]
  changelog           ContactChangelog[]
  emailMessages       EmailMessage[]
  drafts              Draft[]
  profile             ContactProfile?
  memory              ContactMemory?
  edgesOut            ContactEdge[]        @relation("ContactEdge_from")
  edgesIn             ContactEdge[]        @relation("ContactEdge_to")
  lifeEventSignals    LifeEventSignal[]
  feedItems           FeedItem[]

  inboxItems InboxItem[]

  dailyPriorityQueue        DailyPriorityQueue[]
  inboxPriorityItems        InboxPriorityItem[]
  meetingPrepCache          MeetingPrepCache?
  meetingPrepWebCache       MeetingPrepWebCache?
  meetingPersonSummaryCache MeetingPersonSummaryCache[]

  @@index([userId])
  @@index([email])
  @@index([userId, lastInteraction])
  @@index([userId, isNoise])
}

// Structured per-contact attributes extracted by Claude Sonnet from
// interactions + scholarly profile + LinkedIn (M7.1). Powers the
// "About them" section on the contact panel and is a key input to
// the M7.3 reasoning graph queries.
//
// Updated incrementally — the worker only re-runs extraction once a
// contact has accumulated ≥10 new interactions since the snapshot,
// keeping Claude costs bounded.
model ContactProfile {
  id        String @id @default(uuid())
  contactId String @unique

  // Topic/expertise areas pulled from email subjects, journal notes,
  // scholarly publications. Free-form strings to keep the model from
  // collapsing on a closed taxonomy.
  expertiseAreas String[] @default([])

  // Structured-JSON blobs for richer attributes. Shapes documented in
  // src/lib/intelligence/extract-attributes.ts. Kept as Json (not split
  // into columns) so the schema doesn't churn as we tune extraction.
  communicationStyle Json? // { formality, responseSpeed, length }
  geographicContext  Json? // { primaryLocation, travelFrequency }
  personalitySignals Json? // { humor, warmth, interests }

  // Free-text relationship-stage label produced by Claude. One of:
  // new | peer | mentor | mentee | dormant | other. String (not enum)
  // because we may discover new stages during M7 build-out.
  relationshipStage String?

  // Extensible bag for attributes Claude surfaces that don't fit the
  // structured slots above. Reviewed periodically; recurring keys
  // graduate to dedicated fields in future migrations.
  rawAttributes Json @default("{}")

  // Re-extraction throttling. Compare contact.interactionsCount at
  // request time vs interactionsAtGeneration; only re-run if delta
  // exceeds the worker's threshold (10).
  interactionsAtGeneration Int      @default(0)
  generatedAt              DateTime @default(now())
  updatedAt                DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

// Synthesized relational memory per contact (M8.1). Distinct from
// ContactProfile (M7.1) — profile holds STABLE attributes (expertise,
// communication style); memory holds CONVERSATIONAL state (what's
// been discussed, what's open, what they mentioned about themselves).
//
// Generated incrementally: each synthesis pass pulls the prior
// memory and layers in new interactions since interactionsAtSynthesis,
// producing an updated snapshot. Throttled to contacts with ≥5 new
// interactions since the last synthesis.
model ContactMemory {
  id        String @id @default(uuid())
  contactId String @unique

  // Topics that have come up in conversation, with last-mention date
  // and rough frequency. Shape: [{ topic, lastMentioned, frequency }]
  discussedTopics Json @default("[]")

  // Personal things THEY mentioned about themselves (family, life
  // events, opinions). Shape: [{ subject, context, mentionedAt }]
  theyMentioned Json @default("[]")

  // Open conversational threads — questions asked but not answered,
  // commitments made but not fulfilled. Shape:
  // [{ subject, raisedBy: "user"|"them", raisedAt, status }]
  openThreads Json @default("[]")

  // Stable personal context: family, location, role transitions,
  // life events. Shape: { family?, location?, recentTransitions? }
  personalContext Json @default("{}")

  // Recurring themes — topics that surface repeatedly. Surfaced
  // separately from discussedTopics so the UI can lead with them.
  recurringThemes String[] @default([])

  // Throttling — only re-synthesize when delta exceeds threshold.
  interactionsAtSynthesis Int      @default(0)
  synthesizedAt           DateTime @default(now())
  updatedAt               DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

// Emergent relationships between contacts (M7.2). Edges are derived
// from observed signals (shared threads, same org, named mentions,
// introductions) rather than user-asserted. Updated incrementally by
// the graph-edge-extraction worker.
//
// Undirected at the type level, but stored with stable (from, to)
// ordering enforced at insert time (fromContactId < toContactId
// lexicographically) so we don't double-count A→B and B→A.
//
// edgeType values:
//   - mutual_thread: both appeared in the same Thread (covers
//     co-meetings via calendar threads + mutual email/chat threads)
//   - same_org: same Contact.company OR same email domain (non-personal)
//   - mentioned: one appears by name in an email body the other
//     received (Claude Haiku — future commit)
//   - introduced_by_user: user initiated a thread including both, and
//     neither was in a prior thread with the other (future commit)
model ContactEdge {
  id               String   @id @default(uuid())
  userId           String
  fromContactId    String
  toContactId      String
  edgeType         String
  strength         Float    @default(0.5)
  observationCount Int      @default(1)
  evidence         Json     @default("{}")
  firstObservedAt  DateTime @default(now())
  lastReinforcedAt DateTime @default(now())

  fromContact Contact @relation("ContactEdge_from", fields: [fromContactId], references: [id], onDelete: Cascade)
  toContact   Contact @relation("ContactEdge_to", fields: [toContactId], references: [id], onDelete: Cascade)

  @@unique([fromContactId, toContactId, edgeType])
  @@index([userId, edgeType])
  @@index([fromContactId])
  @@index([toContactId])
}

enum InteractionType {
  EMAIL
  MESSAGE
  MEETING
  CALL
  NOTE
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
}

model Interaction {
  id          String               @id @default(uuid())
  contactId   String
  userId      String
  type        InteractionType
  direction   InteractionDirection
  channel     String?
  subject     String?
  summary     String?              @db.Text
  occurredAt  DateTime
  sourceId    String?
  dismissedAt DateTime?
  createdAt   DateTime             @default(now())

  // Stable conversation identifier (legacy — migrating to Thread model)
  chatId      String?
  isGroupChat Boolean @default(false)
  chatName    String?

  // Thread FK (canonical conversation identity, replaces chatId)
  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id])

  // Legacy classifier fields (Interaction.needsReply*) were removed in
  // M0.x.2 — classification now lives on InboxItem.needsResponse.

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId])
  @@index([contactId])
  @@index([occurredAt])
  @@index([userId, occurredAt])
  @@index([userId, contactId, occurredAt])
  @@index([userId, chatId, occurredAt])
  @@index([threadId])
}

// ─── Threads (canonical conversation identity) ─────────────
// A Thread is a stable, source-agnostic conversation that
// multiple Interaction records belong to. It replaces the ad-hoc
// chatId string and normalizes across source-specific threading
// (iMessage chat ROWIDs, Gmail threadIds, LinkedIn DMs, etc.)

model Thread {
  id             String   @id @default(cuid())
  userId         String
  source         String // "imessage", "gmail", "linkedin", "whatsapp", "calendar"
  sourceThreadId String // original ID from source (e.g., chat ROWID, Gmail threadId)
  isGroup        Boolean  @default(false)
  displayName    String? // computed: group name or primary contact name
  lastActivityAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  participants ThreadParticipant[]
  interactions Interaction[]

  @@unique([userId, source, sourceThreadId])
  @@index([userId, lastActivityAt])
  @@index([userId, source])
}

model ThreadParticipant {
  id        String @id @default(cuid())
  threadId  String
  contactId String

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, contactId])
  @@index([contactId])
}

// ─── AI Insights Models ────────────────────────────────────

model RelationshipInsight {
  id          String   @id @default(uuid())
  contactId   String   @unique
  userId      String
  healthScore Int // 0-100
  healthLabel String // thriving | stable | fading | dormant
  summary     String   @db.Text
  actions     String[] // recommended actions
  computedAt  DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WeeklyDigest {
  id        String   @id @default(uuid())
  userId    String
  content   String   @db.Text // JSON blob of structured digest
  weekStart DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, weekStart])
}

// ─── Circles (Community Pockets) ─────────────────────────────

model Circle {
  id           String   @id @default(uuid())
  userId       String
  name         String
  color        String   @default("#6B7280")
  icon         String   @default("users")
  followUpDays Int      @default(30)
  sortOrder    Int      @default(0)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Google contact-group sync (Milestone 3.2). CRM is source of truth;
  // googleGroupResourceName points at the linked group in the user's
  // Google Contacts, and googleGroupAccountId identifies which linked
  // Google account owns it (when the user has multiple).
  googleGroupResourceName String?
  googleGroupAccountId    String?
  googleSyncEnabled       Boolean   @default(false)
  googleSyncedAt          DateTime?
  googleSyncError         String?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts ContactCircle[]

  @@unique([userId, name])
  @@index([userId])
  @@index([googleGroupResourceName])
}

model ContactCircle {
  id        String   @id @default(uuid())
  contactId String
  circleId  String
  addedAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  circle  Circle  @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([contactId, circleId])
  @@index([circleId])
  @@index([contactId])
}

// ─── Action Items (extracted from emails) ────────────────────

enum ActionItemStatus {
  OPEN
  DONE
  DISMISSED
}

model ActionItem {
  id             String           @id @default(uuid())
  userId         String
  contactId      String?
  status         ActionItemStatus @default(OPEN)
  title          String
  context        String?          @db.Text // snippet of the email that triggered it
  sourceId       String? // Gmail message ID
  threadId       String? // Gmail thread ID for grouping
  channel        String? // "gmail", "iMessage", "SMS", "linkedin"
  classification String? // "action_required", "invitation", "fyi"
  dueDate        DateTime?
  extractedAt    DateTime         @default(now())
  resolvedAt     DateTime?
  resolvedBy     String? // "auto" | "manual"

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([contactId])
}

// ─── Contact Sightings (Identity Resolution) ─────────────────

model ContactSighting {
  id          String        @id @default(uuid())
  userId      String
  source      ContactSource
  externalId  String? // source-specific ID for idempotency
  name        String?
  email       String?
  phone       String?
  company     String?
  role        String?
  avatarUrl   String?
  city        String?
  state       String?
  country     String?
  linkedinUrl String?
  rawData     Json? // full original payload
  seenAt      DateTime      @default(now())
  createdAt   DateTime      @default(now())

  // Resolution outcome
  contactId  String?
  resolution SightingResolution @default(PENDING)
  confidence Float?
  resolvedAt DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([userId, source, externalId])
  @@index([userId, resolution])
  @@index([email])
  @@index([phone])
}

// ─── Journal Entries (private relationship notes) ────────────

enum JournalMood {
  POSITIVE
  NEUTRAL
  CONCERN
}

model JournalEntry {
  id        String      @id @default(uuid())
  contactId String
  userId    String
  content   String      @db.Text
  mood      JournalMood @default(NEUTRAL)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Voice-memo support (Milestone 3.1). source="voice" when content
  // came from a Whisper transcription; voiceDurationSec measures the
  // original recording length for display.
  source           String @default("manual")
  voiceDurationSec Int?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([userId])
}

// ─── Contact Changelog (job/role changes) ────────────────────

enum ChangelogType {
  JOB_CHANGE
  ROLE_CHANGE
  COMPANY_CHANGE
  NEWS_MENTION
}

enum ChangelogStatus {
  PENDING
  SEEN
  ACTED
  DISMISSED
}

model ContactChangelog {
  id         String          @id @default(uuid())
  contactId  String
  userId     String
  type       ChangelogType
  field      String // "company", "role"
  oldValue   String?
  newValue   String?
  source     String          @default("linkedin_reimport")
  status     ChangelogStatus @default(PENDING)
  detectedAt DateTime        @default(now())
  actedAt    DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([contactId])
}

// ─── Email Inbox (all synced emails, matched or not) ────────

model EmailMessage {
  id          String               @id @default(uuid())
  userId      String
  gmailId     String // Gmail message ID for dedup
  threadId    String? // Gmail thread ID
  fromEmail   String
  fromName    String?
  toEmail     String
  subject     String?
  snippet     String?              @db.Text
  // Full RFC 822 body — populated by the voice-corpus-index worker for
  // OUTBOUND emails (M6.1). Stays null for inbound until we have a
  // reason to fetch them too. Nullable so backfill is incremental.
  fullBody    String?              @db.Text
  direction   InteractionDirection
  occurredAt  DateTime
  contactId   String? // null if sender not in contacts
  contactName String? // resolved name if matched
  isRead      Boolean              @default(false)
  isAutomated Boolean              @default(false) // true if List-Unsubscribe or Precedence: bulk/list detected
  createdAt   DateTime             @default(now())

  // Per-email mention extraction (M7.2 expansion). Populated by the
  // mention-extraction worker via Claude Haiku entity recognition.
  // - mentionsProcessedAt IS NULL  → not yet processed
  // - mentionsProcessedAt IS NOT NULL → processed; mentionedContactIds
  //   holds 0+ matched contact IDs
  // Powers the `mentioned` edge type in ContactEdge.
  mentionedContactIds String[]  @default([])
  mentionsProcessedAt DateTime?

  // M0.x.3: Life event extraction (Haiku) tracking. Mirrors the
  // mention-extraction pattern. NULL → not processed; non-NULL →
  // processed (a LifeEventSignal row may or may not have been
  // created depending on whether the model detected a signal).
  lifeEventProcessedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  voiceExample VoiceExample?

  @@unique([userId, gmailId])
  @@index([userId, occurredAt])
  @@index([contactId])
  // Lets the mention-extraction worker quickly find unprocessed rows.
  @@index([userId, mentionsProcessedAt])
  @@index([userId, lifeEventProcessedAt])
}

// ─── Voice Model (Phase 6) ──────────────────────────────────
// One row per user. Holds the learned voice fingerprint (aggregated
// from VoiceExample rows by the worker) plus manual overrides from
// /settings/voice. The worker regenerates `learned` on each re-index;
// `overrides` is sticky across re-indexing.
model VoiceProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  learned           Json      @default("{}")
  overrides         Json      @default("{}")
  // Per-user signature lines detected via statistical frequency analysis
  // (M6.1.1). Lines appearing verbatim at end-of-body in ≥30% of emails
  // are signature. Stripped before feature extraction so n-grams /
  // opening / closing detection don't pick up Jennifer's footer block
  // as "voice." Sorted longest-first for deterministic display.
  signatureLines    String[]  @default([])
  indexedEmailCount Int       @default(0)
  oldestIndexedAt   DateTime?
  newestIndexedAt   DateTime?
  lastIndexedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per indexed outbound email. Deterministically-extracted
// features power the fingerprint UI (M6.2); the vector embedding
// powers few-shot retrieval in M6.3.
//
// Relationship type values match src/lib/voice/relationship-classifier.ts:
// former_student | peer_faculty | industry_exec | media | family | board
// | casual | unknown.
model VoiceExample {
  id               String   @id @default(uuid())
  userId           String
  emailMessageId   String   @unique
  gmailId          String
  relationshipType String
  openingType      String?
  closingType      String?
  wordCount        Int
  avgSentenceLen   Float
  signaturePhrases String[] @default([])
  sentAt           DateTime
  indexedAt        DateTime @default(now())

  // 512-dim Voyage embedding for semantic similarity retrieval.
  // Managed via raw SQL — Prisma doesn't natively support the vector
  // type, so `Unsupported` keeps the column visible in the schema
  // without breaking the query API.
  embedding Unsupported("vector(512)")?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([userId, relationshipType])
  @@index([userId, sentAt(sort: Desc)])
}

// ─── Voice References (M0.x.5) ───────────────────────────────
// Jennifer's intentional voice — knowledge-base files exported
// from her custom GPTs ("Writer's Room — Humor Helper", style
// guides, etc.). These DOMINATE the voice corpus during draft
// generation because they represent how she WANTS to write,
// not just how she has written historically.
//
// Each uploaded file becomes one row. At upload we:
//   1. Extract plain text (txt/md direct, pdf via pdf-parse,
//      docx via mammoth)
//   2. SHA-256 hash for dedup per user
//   3. Voyage-embed for semantic retrieval
//   4. Haiku-extract structured guidance into `guidance` JSON
//      (greetings, closings, signature phrases, avoid phrases,
//      tone notes) — that block is what gets merged into the
//      voice prompt at draft time.

model VoiceReference {
  id          String   @id @default(cuid())
  userId      String
  filename    String
  /// "gpt_knowledge_base" | "manual_upload" | "book_excerpt" | "style_guide"
  sourceType  String   @default("gpt_knowledge_base")
  /// Extracted plain text (capped at MAX_REFERENCE_TEXT_BYTES at upload time)
  content     String   @db.Text
  /// SHA-256 of the extracted content — dedup per user
  contentHash String
  /// Tier weight used by the prompt builder. Defaults match the
  /// spec: 1.0 for gpt_knowledge_base, 0.3 for other reference
  /// types. Higher = stronger prompt prominence.
  weight      Float    @default(1.0)
  /// Original byte size of the uploaded file (pre-extraction)
  byteSize    Int      @default(0)
  /// Structured Haiku-extracted style guidance. Shape:
  /// { applicableRelationships: string[] | "all", greetings: [],
  ///   closings: [], signaturePhrases: [], avoidPhrases: [],
  ///   toneNotes: string }
  guidance    Json?
  /// Voyage 512-dim embedding for semantic retrieval at draft time.
  /// NULL if Voyage was unavailable at upload — those rows still
  /// contribute as wholesale prompt context, just not via retrieval.
  embedding   Unsupported("vector(512)")?
  addedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-user dedup. Re-uploading the same file is a no-op.
  @@unique([userId, contentHash])
  @@index([userId, addedAt(sort: Desc)])
}

// ─── Drafts (persistent AI-generated messages) ──────────────

enum DraftStatus {
  DRAFT
  SENT
  DISCARDED
}

enum DraftType {
  REPLY_EMAIL
  CATCHING_UP
  CONGRATULATE
  ASK
  FOLLOW_UP
}

model Draft {
  id          String      @id @default(uuid())
  userId      String
  contactId   String
  status      DraftStatus @default(DRAFT)
  type        DraftType
  tone        String // casual, warm, professional, congratulatory, checking_in
  content     String      @db.Text
  subjectLine String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  sentAt      DateTime?

  // Gmail integration — populated when "Save to Gmail" succeeds. Allows
  // future regenerations to update the same Gmail draft instead of
  // creating duplicates.
  gmailDraftId       String?
  gmailThreadId      String?
  inReplyToMessageId String?
  recipientEmail     String?
  savedToGmailAt     DateTime?

  // Link back to the InboxItem that triggered this draft (M0.9 task 5).
  // Set when the inbox-draft-prepopulate worker auto-generates a
  // draft for an OPEN inbox item; null for drafts the user started
  // manually. Unique so the worker can't create duplicate drafts
  // for the same item on a re-run.
  inboxItemId String? @unique
  inboxItem   InboxItem? @relation(fields: [inboxItemId], references: [id], onDelete: SetNull)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([contactId])
  @@index([gmailDraftId])
}

// ─── Gmail Sync State ────────────────────────────────────────

model GmailSyncState {
  id                   String    @id @default(uuid())
  userId               String    @unique
  historyId            String?
  lastSyncAt           DateTime?
  syncEnabled          Boolean   @default(false)
  contactsImported     Boolean   @default(false)
  additionalUserEmails String[]  @default([]) // Other email addresses belonging to this user (for direction detection)
  unmatchedSenders     Json? // Array of { email: string, count: number } — senders with no matching contact
  mutedThreads         String[]  @default([]) // Gmail threadIds that the user has muted (auto-dismiss future inbound)
  /// When the active Gmail Pub/Sub watch expires (1.2). Renewed by the
  /// worker watch-renew task; null when push sync isn't configured.
  watchExpiration      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Active Calendar push channels (1.3). One row per (account, calendar)
/// pair so multi-calendar setups can each have their own watch.
/// channelId + resourceId are required to stop a channel cleanly.
model CalendarWatchChannel {
  id         String   @id @default(uuid())
  userId     String
  accountId  String
  calendarId String
  channelId  String
  resourceId String
  expiration DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([accountId, calendarId])
  @@index([expiration])
}

// ─── WhatsApp Sync State ─────────────────────────────────────

model WhatsAppSyncState {
  id              String    @id @default(uuid())
  userId          String    @unique
  phone           String
  connected       Boolean   @default(false)
  lastMessageAt   DateTime?
  messagesSynced  Int       @default(0)
  contactsMatched Int       @default(0)
  unmatchedChats  Json? // Array of { phone, displayName, messageCount }
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── iMessage Sync State (Mac chat.db → individual messages) ─────────

model IMessageSyncState {
  id              String    @id @default(uuid())
  userId          String
  handleId        String // phone number or email
  contactId       String? // matched CRM contact ID (for reverse lookup)
  service         String // "iMessage" or "SMS"
  lastMessageGuid String? // GUID of the most recent synced message
  lastSyncAt      DateTime?
  messageCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, handleId])
  @@index([userId])
  @@index([userId, contactId])
}

// ─── Extension Auth Tokens (Chrome extension bearer auth) ────

model ExtensionToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  label      String    @default("Extension")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Inbox Items (persistent needs-response tracker) ─────────

enum InboxItemStatus {
  OPEN
  RESOLVED
  DISMISSED
  SNOOZED
}

// Saved natural-language network queries (M7.4). Jennifer can star a
// query she's likely to ask again ("Who's in NYC this week?") and
// re-run it from the /queries page. Each row stores just the query
// string — re-running re-fires the orchestrator against current
// state, so the answer freshens automatically.
//
// Title is auto-set from the answer's title on first run, but
// user-editable.
model SavedQuery {
  id        String    @id @default(uuid())
  userId    String
  query     String    @db.Text
  title     String?
  createdAt DateTime  @default(now())
  // Bumped each time the user re-runs from the /queries page.
  // Powers default sort ("recently used" first).
  lastRunAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastRunAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// Unprompted observations the assistant surfaces on the dashboard
// (M9.2). One row per noticing — "you haven't replied to David", "Marc
// asked something specific 5 days ago", "Sarah moved cities last week."
//
// Generated daily by the observations-generation worker. UI caps the
// surfaced count at 1-2 at a time so the dashboard stays calm. User
// can dismiss; dismissed rows stay in the table for history but never
// re-surface.
model AssistantObservation {
  id         String  @id @default(uuid())
  userId     String
  content    String  @db.Text
  // Optional anchor to a specific contact — UI links to their panel.
  contactId  String?
  // Tag for what produced this observation: "unanswered_inbound",
  // "stale_open_thread", "recent_life_event", "dormant_inner_circle",
  // etc. Used for analytics + future personalization.
  source     String
  // Source-record refs for provenance (email IDs, changelog IDs).
  sourceRefs Json    @default("[]")

  shownAt     DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dashboard query: undismissed observations, newest first.
  @@index([userId, dismissedAt, createdAt(sort: Desc)])
}

model InboxItem {
  id        String @id @default(uuid())
  userId    String
  contactId String
  channel   String // normalized: "text", "email", "linkedin"
  threadKey String @default("") // group chat ID or email thread ID

  status      InboxItemStatus @default(OPEN)
  resolvedAt  DateTime?
  resolvedBy  String? // "auto_sync" | "manual" | "dismissed" | "snoozed"
  snoozeUntil DateTime?

  // Denormalized contact info (avoids JOINs on every render)
  contactName        String
  company            String?
  tier               String
  isGroupChat        Boolean @default(false)
  contactEmail       String?
  contactPhone       String?
  contactLinkedinUrl String?

  // The inbound trigger
  triggerInteractionId String
  triggerAt            DateTime

  // Cached message previews (JSON array, updated on each new inbound)
  messagePreview Json? // [{summary, occurredAt, channel}]
  messageCount   Int   @default(1)

  // Cached priority (recomputed on create/update)
  priority      String? // "high", "medium", "low"
  priorityScore Int? // 0-100

  // Provenance — why this item is here, with source records the user can audit.
  sourceSystem    String? // "gmail" | "imessage" | "linkedin" | "whatsapp"
  sourceRecordIds Json? // string[] like ["interaction:abc", "email:xyz"]
  surfacedReason  String? // persisted score breakdown ("Inner circle · Sent today")

  // M0.x.2: Haiku-driven "does this actually need a reply?" classifier.
  // needsResponse=null means not yet classified (fail-open: render it).
  // Categories: question | request | fyi | thanks | acknowledgment |
  // social | newsletter | autoresponder. Default inbox view filters
  // out items where needsResponse=false; an "All inbound" tab restores
  // the full list. Manual overrides write to ClassifierFeedback for
  // future training.
  needsResponse      Boolean?
  responseConfidence Float?
  responseReason     String?
  responseCategory   String?
  classifiedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact            Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  draft              Draft?
  classifierFeedback ClassifierFeedback[]

  @@unique([userId, contactId, channel, threadKey])
  @@index([userId, status])
  @@index([userId, status, triggerAt])
  @@index([userId, status, needsResponse])
  @@index([contactId])
}

// ─── Classifier feedback (M0.x.2) ─────────────────────────────
// Records every manual override of the needs-response classifier so
// we can audit accuracy and tune the system prompt later. modelDecision
// is what the classifier said; userDecision is what Jennifer overrode
// to. Free text bodyExcerpt lets us reread the message during review
// without joining back to EmailMessage.

model ClassifierFeedback {
  id            String   @id @default(cuid())
  userId        String
  inboxItemId   String
  bodyExcerpt   String   @db.Text
  modelDecision Boolean
  userDecision  Boolean
  reason        String?
  category      String?
  confidence    Float?
  overriddenAt  DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inboxItem InboxItem @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)

  @@index([userId, overriddenAt])
  @@index([inboxItemId])
}

// ─── Historical orphan models (M0.3 backfill) ───────────────────────────
// These models existed in earlier app versions; the tables still hold
// real data in prod (ApiUsageLog has 4068 rows of token-spend history,
// MergeLog has 94 rows of merge audit, etc), but the application code
// has stopped referencing them. They live in the schema so:
//   1. `prisma migrate dev` from a fresh clone replays the same schema
//   2. `prisma migrate status` doesn't report drift
//   3. Future code that wants to read this historical data can do so
//      through the generated Prisma client.
// If you genuinely want to drop one of these, write a new migration
// that DROPs the table AND remove the model + back-relations here in
// the same change.

enum AiModel {
  HAIKU
  SONNET
}

enum AiFeature {
  DRAFT
  CLASSIFICATION
  BRIEF
  CHAT
  ACTIONS
  INSIGHTS
  ENRICHMENT
}

enum ImportSource {
  LINKEDIN_CONNECTIONS
  LINKEDIN_MESSAGES
  GOOGLE_CONTACTS
}

enum ImportStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model ApiUsageLog {
  id               String    @id @default(uuid())
  userId           String
  model            AiModel
  feature          AiFeature
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ImportLog {
  id          String       @id @default(uuid())
  userId      String
  source      ImportSource
  importedAt  DateTime     @default(now())
  recordCount Int
  status      ImportStatus @default(SUCCESS)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, source])
}

model MergeLog {
  id                String    @id @default(uuid())
  userId            String
  primaryContactId  String
  mergedContactIds  String[]
  snapshotJson      Json
  fieldsAdded       Json
  conflictsResolved Json
  mergedAt          DateTime  @default(now())
  undoneAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, mergedAt])
  @@index([primaryContactId])
}

model DailyPriorityQueue {
  id             String    @id @default(uuid())
  userId         String
  contactId      String
  score          Int
  triggerType    String
  triggerContext Json
  generatedAt    DateTime  @default(now())
  actionedAt     DateTime?
  snoozedUntil   DateTime?
  dismissedAt    DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
  @@index([userId, actionedAt])
}

model InboxPriorityItem {
  id                     String    @id @default(uuid())
  userId                 String
  contactId              String
  threadId               String
  subject                String?
  snippet                String?
  receivedAt             DateTime
  senderInteractionCount Int       @default(0)
  isActive               Boolean   @default(true)
  dismissedUntil         DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId, isActive])
}

model MeetingPrepCache {
  id                   String   @id @default(uuid())
  contactId            String   @unique
  generatedAt          DateTime @default(now())
  historySummary       String
  talkingPoints        String[]
  lastMentionedBullets String[]

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, generatedAt])
}

model MeetingPrepWebCache {
  id         String   @id @default(uuid())
  contactId  String   @unique
  searchedAt DateTime @default(now())
  findings   Json

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, searchedAt])
}

model MeetingPersonSummaryCache {
  id         String   @id @default(uuid())
  name       String
  contactId  String?
  fetchedAt  DateTime @default(now())
  crmContext Json?
  webSummary String?

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([name, contactId])
  @@index([fetchedAt])
}

// ─── Feed (M0.x.3) ─────────────────────────────────────────────
// Two-layer model for ambient network awareness:
// 1. LifeEventSignal — raw extractions from inbound messages (one
//    row per detected event per message). Source of truth.
// 2. FeedItem — aggregated + deduplicated for display. Pulled from
//    LifeEventSignal + ContactChangelog by the feed-aggregate worker.
//
// Separation lets the aggregator dedupe across sources (same job
// change detected from a LinkedIn delta + a "starting at X" email
// becomes one FeedItem, not two) while keeping the raw extraction
// audit trail intact.

model LifeEventSignal {
  id             String   @id @default(cuid())
  userId         String
  contactId      String
  /// life_event | announcement | milestone
  signalType     String
  /// 1-line summary written by the extractor
  summary        String
  /// email | message — which channel the signal came from
  sourceType     String
  /// EmailMessage.id (or future Interaction.id for message channels)
  sourceRecordId String
  /// Excerpt of the message that triggered detection (for audit)
  body           String   @db.Text
  detectedAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, detectedAt])
  @@index([contactId])
}

model FeedItem {
  id             String   @id @default(cuid())
  userId         String
  contactId      String
  /// job_change | publication | news_mention | life_event | award | announcement
  itemType       String
  /// Single-line headline ("Marcus Chen became CEO at OpenEvidence")
  headline       String
  /// Optional longer body / context
  body           String?
  /// changelog | email | message | web — which upstream source
  sourceType     String
  /// Upstream row ID (ContactChangelog.id, LifeEventSignal.id, etc.)
  sourceRecordId String
  /// External URL (news article, LinkedIn post) when applicable
  linkUrl        String?
  /// When the underlying event happened (used for time grouping)
  detectedAt     DateTime
  isHighlighted  Boolean  @default(false)
  isHidden       Boolean  @default(false)
  createdAt      DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Dedup constraint — one row per (contact, event type, source).
  // The aggregator UPDATEs an existing row instead of creating a
  // duplicate when the same event surfaces from multiple paths.
  @@unique([userId, contactId, itemType, sourceRecordId])
  @@index([userId, isHidden, detectedAt(sort: Desc)])
  @@index([contactId, detectedAt])
}
