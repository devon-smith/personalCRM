# Same shape as the baileys sidecar. AUTH_DIR is renamed conceptually to
# SESSION_DIR (open-wa stores Chrome user data, not just creds), but the
# variable name is kept for parity.
CRM_BASE_URL=http://localhost:3003
CRM_EXTENSION_TOKEN=your-extension-token-here

# Where open-wa stores its Chrome user-data directory + session.data.json.
SESSION_DIR=./session-data

# open-wa sessionId — change if you want to run multiple sessions side by side.
SESSION_ID=personalcrm

# Optional: path to Chrome/Chromium if you don't want open-wa to download
# its own (~100MB on first install). Skip on Mac if you have Chrome installed.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

LOG_LEVEL=info
